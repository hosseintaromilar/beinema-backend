# /opt/beinema/api.env on the server: the backend's settings. Never commit the real file.
# The database settings are in docker-compose.yml.

JWT_SECRET=
METIS_API_KEY=
GOOGLE_CLIENT_ID=

BEINEMA_BRAIN_MODE=orchestrated
BEINEMA_DEBUG_SHOW_DIRECTOR_PACKET=false
PUBLIC_SITE_URL=https://beinema.ir
FRONTEND_URL=https://beinema.ir

# admins sign in with these numbers (comma-separated)
BEINEMA_ADMIN_PHONES=
BEINEMA_STATE_PANEL_PHONES=
