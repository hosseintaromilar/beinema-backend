# All settings of the backend that change between machines, as environment
# variable names. Copy this file:
#   .env.local       local development (read automatically on start)
#   .env.production  the production copy (upload in Liara: beinema-api > settings > variables)
# Both copies are git-ignored. A real environment variable always wins.

# --- secrets (required: the backend does not start without the first two) ---
JWT_SECRET=
METIS_API_KEY=
# the bare Melipayamak key, without ${...}
MELIPAYAMAK_API_KEY=

# --- database ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/beinema
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# --- people (comma-separated phone numbers) ---
# become admin when they log in
BEINEMA_ADMIN_PHONES=
# log in without an SMS code (the admins who test the system)
BEINEMA_OTP_BYPASS_PHONES=09914816794,09379736278
# their fixed 4-digit login code instead of the SMS; set it in production,
# empty = they sign in with no code at all (only for local development)
BEINEMA_OTP_BYPASS_CODE=
# see the counselor's decision path in a room's three-dot menu
BEINEMA_STATE_PANEL_PHONES=09914816794,09379736278

# --- app ---
# where invitation links point
FRONTEND_URL=http://localhost:3000
# workflow = Metis v2, orchestrated = v3 (director, voice, planner, teacher)
BEINEMA_BRAIN_MODE=orchestrated
BEINEMA_DEBUG_SHOW_DIRECTOR_PACKET=false
# uploaded files (avatars, agent photos, chat files)
BEINEMA_UPLOAD_DIR=uploads
# Sign in with Google: OAuth client id from Google Cloud; empty hides the button
GOOGLE_CLIENT_ID=

# the address in shared links (invitations, blog); production default is https://beinema.ir
PUBLIC_SITE_URL=http://localhost:3000
